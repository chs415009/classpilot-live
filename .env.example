# Copy to .env and fill in. Never commit .env.
# Only needed when BACKEND=cortex and for scripts/. Mock mode needs nothing here.
#
# Auth: key pair on the service user created in sql/01_setup_objects.sql.
# Keep the private key outside the repo.
# Account identifier format: orgname-accountname (no .snowflakecomputing.com).
# Leave the key password empty if the key was created with -nocrypt.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=CLASSPILOT_AGENT_SVC
SNOWFLAKE_PRIVATE_KEY_FILE=<path/to/private_key.p8>
SNOWFLAKE_PRIVATE_KEY_PASSWORD=
SNOWFLAKE_ROLE=CLASSPILOT_AGENT_ROLE
SNOWFLAKE_WAREHOUSE=CLASSPILOT_WH
SNOWFLAKE_DATABASE=CLASSPILOT_DEMO
SNOWFLAKE_SCHEMA=AGENT

# Optional overrides of config/settings.yaml
# BACKEND=mock
